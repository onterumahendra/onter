      "maxRows": 5,
      "columns": [
        {
          "label": "Property Type",
          "name": "type",
          "type": "select",
          "options": ["House", "Flat/Apartment", "Commercial Property", "Land", "Vehicle", "Other"]
        },
        {
          "label": "Location/Details",
          "name": "details",
          "type": "text",
          "placeholder": "Address or description"
        }
      ]
    },
    {
      "section": "Important Documents Location",
      "type": "simple",
      "priority": "recommended",
      "estimatedTime": 3,
      "skippable": true,
      "description": "Where you keep important papers",
      "fields": [
        {
          "label": "Bank Locker Details (if any)",
          "name": "bank_locker",
