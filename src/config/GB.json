    {
      "id": "personalDetails",
      "type": "simple",
      "fields": [
        {
          "validation": {
            "required": true,
            "minLength": 2
          },
          "name": "full_name",
          "type": "text"
        },
        {
          "validation": {
            "required": true
          },
          "name": "date_of_birth",
          "type": "date"
        },
        {
          "validation": {
            "pattern": "^[A-CEGHJ-PR-TW-Z]{2} ?[0-9]{2} ?[0-9]{2} ?[0-9]{2} ?[A-D]$"
          },
          "name": "national_insurance_number",
          "type": "text"
        },
        {
          "validation": {
            "pattern": "^[0-9]{10}$|^[0-9]{3} [0-9]{3} [0-9]{4}$"
          },
          "name": "nhs_number",
          "type": "text"
        },
        {
          "validation": {
            "pattern": "^[A-Za-z0-9]{6,12}$"
          },
          "name": "passport_no",
          "type": "text"
        },
        {
          "name": "drivers_license_no",
          "type": "text"
        },
        {
          "name": "phone",
          "type": "text"
        },
        {
          "validation": {
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "name": "email",
