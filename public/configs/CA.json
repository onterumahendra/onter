{
  "countryCode": "CA",
  "countryName": "Canada",
  "currency": "CAD",
  "currencySymbol": "$",
  "formSections": [
    {
      "section": "Personal Details",
      "type": "simple",
      "description": "Please provide your legal identity and contact details",
      "fields": [
        {
          "label": "Full Legal Name",
          "name": "full_name",
          "type": "text",
          "placeholder": "Full legal name",
          "validation": {
            "required": true,
            "minLength": 2,
            "errorMessage": "Full legal name is required"
          }
        },
        {
          "label": "Social Insurance Number (SIN)",
          "name": "sin",
          "type": "text",
          "placeholder": "123 456 789",
          "validation": {
            "required": true,
            "pattern": "^[0-9]{3} [0-9]{3} [0-9]{3}$|^[0-9]{9}$",
            "errorMessage": "SIN must be 9 digits or in format: 123 456 789"
          }
        },
        {
          "label": "Date of Birth",
          "name": "date_of_birth",
          "type": "date",
          "validation": {
            "required": true,
            "errorMessage": "Date of birth is required"
          }
        },
        {
          "label": "Provincial Health Card Number",
          "name": "health_card_no",
          "type": "text",
          "placeholder": "Provincial health card number",
          "validation": {
            "required": true,
            "errorMessage": "Health card number is required"
          }
        },
        {
          "label": "Blood Group",
          "name": "blood_group",
          "type": "select",
          "options": [
            "A+",
            "A-",
            "B+",
            "B-",
            "AB+",
            "AB-",
            "O+",
            "O-"
          ],
          "placeholder": "Select blood group",
          "validation": {
            "required": true,
            "errorMessage": "Blood group is required for medical emergencies"
          }
        },
        {
          "label": "Passport No.",
          "name": "passport_no",
          "type": "text",
          "placeholder": "Passport number or N/A",
          "validation": {
            "pattern": "^[A-Z0-9]{6,9}$",
            "errorMessage": "Passport number should be 6-9 alphanumeric characters"
          }
        },
        {
          "label": "Driver's License / Provincial ID",
          "name": "drivers_license_no",
          "type": "text",
          "placeholder": "License or ID number",
          "validation": {
            "pattern": "^[A-Za-z0-9]{5,20}$",
            "errorMessage": "License or ID must be 5-20 alphanumeric characters"
          }
        },
        {
          "label": "Primary Phone Number",
          "name": "phone",
          "type": "text",
          "placeholder": "(XXX) XXX-XXXX",
          "validation": {
            "required": true,
            "pattern": "^\\([0-9]{3}\\) [0-9]{3}-[0-9]{4}$",
            "errorMessage": "Phone number must be in format: (XXX) XXX-XXXX"
          }
        },
        {
          "label": "Email Address",
          "name": "email",
          "type": "email",
          "placeholder": "name@example.com",
          "validation": {
            "required": true,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "errorMessage": "Please enter a valid email address"
          }
        },
        {
          "label": "Residential Address",
          "name": "residential_address",
          "type": "text",
          "placeholder": "Street address, city, province, postal code"
        }
      ]
    },
    {
      "section": "Emergency contact details",
      "type": "table",
      "description": "Add emergency contacts for urgent situations",
      "minRows": 1,
      "maxRows": 10,
      "columns": [
        {
          "label": "Contact Type",
          "name": "contact_type",
          "type": "select",
          "options": [
            "Spouse",
            "Parent",
            "Child",
            "Sibling",
            "Friend",
            "Doctor",
            "Hospital",
            "Emergency Service",
            "Neighbor",
            "Other"
          ],
          "validation": {
            "required": true,
            "errorMessage": "Please select contact type"
          }
        },
        {
          "label": "Name",
          "name": "name",
          "type": "text",
          "placeholder": "Contact name",
          "validation": {
            "required": true,
            "minLength": 2,
            "maxLength": 100,
            "errorMessage": "Name must be between 2 and 100 characters"
          }
        },
        {
          "label": "Phone No.",
          "name": "phone",
          "type": "text",
          "placeholder": "(XXX) XXX-XXXX",
          "validation": {
            "required": true,
            "pattern": "^\\([0-9]{3}\\) [0-9]{3}-[0-9]{4}$",
            "errorMessage": "Phone number must be in format: (XXX) XXX-XXXX"
          }
        }
      ]
    },
    {
      "section": "Insurance details",
      "type": "table",
      "description": "Medical, life, auto, and other insurance policies",
      "maxRows": 20,
      "columns": [
        {
          "label": "Policy Holder Name",
          "name": "insured_name",
          "type": "text",
          "placeholder": "Insured person's name",
          "validation": {
            "required": true,
            "errorMessage": "Policy holder name is required"
          }
        },
        {
          "label": "Insurance Type",
          "name": "insurance_type",
          "type": "select",
          "options": [
            "Health",
            "Life",
            "Auto",
            "Home",
            "Tenant",
            "Travel",
            "Disability",
            "Property",
            "Other"
          ],
          "validation": {
            "required": true,
            "errorMessage": "Please select insurance type"
          }
        },
        {
          "label": "Provider",
          "name": "provider",
          "type": "text",
          "placeholder": "Insurance company",
          "validation": {
            "required": true,
            "errorMessage": "Provider is required"
          }
        },
        {
          "label": "Policy No.",
          "name": "policy_no",
          "type": "text",
          "placeholder": "Policy number",
          "validation": {
            "required": true,
            "errorMessage": "Policy number is required"
          }
        },
        {
          "label": "Member / Group ID",
          "name": "member_id",
          "type": "text",
          "placeholder": "Member or group ID"
        },
        {
          "label": "Premium Amount",
          "name": "premium_amount",
          "type": "number",
          "placeholder": "Monthly or annual premium",
          "validation": {
            "required": true,
            "min": 0,
            "errorMessage": "Please enter valid amount"
          }
        },
        {
          "label": "Due Date",
          "name": "due_date",
          "type": "date",
          "validation": {
            "required": true,
            "errorMessage": "Due date is required"
          }
        }
      ]
    },
    {
      "section": "Bank details",
      "type": "table",
      "description": "Your bank and account information",
      "maxRows": 15,
      "columns": [
        {
          "label": "Account Holder Name",
          "name": "holder_name",
          "type": "text",
          "placeholder": "Name on account",
          "validation": {
            "required": true,
            "errorMessage": "Account holder name is required"
          }
        },
        {
          "label": "Bank Name",
          "name": "bank_name",
          "type": "text",
          "placeholder": "Bank name",
          "validation": {
            "required": true,
            "errorMessage": "Bank name is required"
          }
        },
        {
          "label": "Account Type",
          "name": "account_type",
          "type": "select",
          "options": [
            "Checking",
            "Savings",
            "TFSA",
            "RRSP",
            "Brokerage",
            "Other"
          ],
          "validation": {
            "required": true,
            "errorMessage": "Please select account type"
          }
        },
        {
          "label": "Institution No.",
          "name": "institution_no",
          "type": "text",
          "placeholder": "3-digit institution number",
          "validation": {
            "required": true,
            "pattern": "^[0-9]{3}$",
            "errorMessage": "Institution number must be 3 digits"
          }
        },
        {
          "label": "Transit No.",
          "name": "transit_no",
          "type": "text",
          "placeholder": "5-digit transit number",
          "validation": {
            "required": true,
            "pattern": "^[0-9]{5}$",
            "errorMessage": "Transit number must be 5 digits"
          }
        },
        {
          "label": "Account No.",
          "name": "account_no",
          "type": "text",
          "placeholder": "Account number",
          "validation": {
            "required": true,
            "errorMessage": "Account number is required"
          }
        },
        {
          "label": "Branch / Address",
          "name": "branch_address",
          "type": "text",
          "placeholder": "Branch name or address"
        }
      ]
    },
    {
      "section": "IMPORTANT DOCUMENTS LOCATION",
      "type": "table",
      "description": "Where you keep important legal and personal documents",
      "maxRows": 20,
      "columns": [
        {
          "label": "Document Type",
          "name": "doc_type",
          "type": "select",
          "options": [
            "Birth Certificate",
            "Passport",
            "SIN Confirmation",
            "Health Card",
            "Marriage Certificate",
            "Property Deed / Mortgage",
            "Will / Testament",
            "Power of Attorney",
            "Educational Certificates",
            "Insurance Policies",
            "Tax Returns",
            "Medical Records",
            "Other"
          ],
          "validation": {
            "required": true,
            "errorMessage": "Document type is required"
          }
        },
        {
          "label": "Location",
          "name": "location",
          "type": "text",
          "placeholder": "Where stored",
          "validation": {
            "required": true,
            "errorMessage": "Location is required"
          }
        }
      ]
    },
    {
      "section": "Additional details",
      "type": "simple",
      "description": "Any other important information",
      "fields": [
        {
          "label": "Additional Notes",
          "name": "notes",
          "type": "textarea",
          "placeholder": "Enter any additional information...",
          "validation": {
            "maxLength": 5000,
            "errorMessage": "Notes cannot exceed 5000 characters"
          }
        }
      ]
    }
  ],
  "accessGuide": {
